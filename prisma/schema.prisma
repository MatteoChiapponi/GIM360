generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  OWNER
  TRAINER
  RECEPTIONIST
}

enum GymStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
}

enum StudentFileType {
  FICHA
  APTO_MEDICO
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

/// Cómo se calcula el descuento sobre el precio de lista de la cuota.
/// PERCENTAGE   → value es un porcentaje (0-100) que se resta.
/// FIXED_AMOUNT → value es un monto fijo que se resta.
/// FIXED_PRICE  → value es el precio final de la cuota (beca / precio especial).
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
}

enum PaymentAdjustmentType {
  NONE
  SURCHARGE
  DISCOUNT
}

/// Cómo se calcula el recargo por mora: un monto fijo en pesos o un % de la cuota.
enum LateFeeType {
  FIXED
  PERCENT
}

// ─── Modelos ─────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  role           UserRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        Owner?
  trainer      Trainer?
  receptionist Receptionist?
}

model Owner {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  gyms Gym[]
}

model Gym {
  id        String    @id @default(cuid())
  ownerId   String
  owner     Owner     @relation(fields: [ownerId], references: [id])
  name      String
  address   String?
  phone     String?
  status    GymStatus @default(ACTIVE)
  createdAt DateTime  @default(now())

  trainers      Trainer[]
  receptionists Receptionist[]
  students      Student[]
  groups        Group[]
  fixedExpenses FixedExpense[]
  payments      Payment[]
  cashClosings  CashClosing[]
  studentFiles  StudentFile[]
  attendances   Attendance[]
  discounts     Discount[]

  paymentMethodConfigs PaymentMethodConfig[]
  lateFeeConfig        LateFeeConfig?

  @@index([ownerId])
}

model FixedExpense {
  id        String   @id @default(cuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name      String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([gymId])
}

model Trainer {
  id           String       @id @default(cuid())
  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  gymId        String
  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name         String
  active       Boolean      @default(true)
  startedAt    DateTime?
  createdAt    DateTime     @default(now())

  groups TrainerGroup[]

  @@index([gymId])
}

model Receptionist {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([gymId])
}

model Student {
  id                   String           @id @default(cuid())
  gymId                String
  gym                  Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  firstName            String
  lastName             String
  birthDate            DateTime?
  nationalId           String?
  phone1               String
  phone2               String?
  emergencyPhone       String?
  emergencyContact     String?
  joinedAt             DateTime         @default(now())
  leftAt               DateTime?
  status               StudentStatus    @default(ACTIVE)
  trialEndsAt          DateTime?
  dueDay               Int              @default(1)
  /// Alumno exento del recargo por mora (beca, arreglo particular).
  lateFeeExempt        Boolean          @default(false)
  createdAt            DateTime         @default(now())

  groups    StudentGroup[]
  payments  Payment[]
  files     StudentFile[]
  discounts StudentDiscount[]

  @@index([gymId])
}

model Group {
  id           String   @id @default(cuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name         String
  monthlyPrice Decimal  @db.Decimal(10, 2)
  maxCapacity  Int?
  createdAt    DateTime @default(now())

  trainers    TrainerGroup[]
  students    StudentGroup[]
  schedules   Schedule[]
  attendances Attendance[]

  @@index([gymId])
}

model TrainerGroup {
  id         String   @id @default(cuid())
  trainerId  String
  trainer    Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hourlyRate Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  schedules TrainerGroupSchedule[]

  @@unique([trainerId, groupId])
  @@index([groupId])
}

model TrainerGroupSchedule {
  id             String       @id @default(cuid())
  trainerGroupId String
  trainerGroup   TrainerGroup @relation(fields: [trainerGroupId], references: [id], onDelete: Cascade)
  weekDay        DayOfWeek
  startTime      String // "HH:MM"
  endTime        String // "HH:MM"
  createdAt      DateTime     @default(now())

  @@unique([trainerGroupId, weekDay])
  @@index([trainerGroupId])
}

model StudentGroup {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, groupId])
  @@index([groupId])
}

model Schedule {
  id          String      @id @default(cuid())
  groupId     String
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  weekDays    DayOfWeek[]
  startTime   String // format "HH:MM"
  endTime     String // format "HH:MM"
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime    @default(now())

  @@index([groupId])
}

model Payment {
  id            String         @id @default(cuid())
  gymId         String
  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  period        DateTime       // first day of the month: 2026-04-01T00:00:00Z

  // ── Precio de la cuota ─────────────────────────────────────────────────
  // Se define al generarla: el precio de lista de los grupos menos el descuento
  // vigente del alumno.  amount = listAmount - discountAmount
  listAmount     Decimal  @db.Decimal(10, 2) // suma de los grupos, sin descuento
  discountAmount Decimal  @db.Decimal(10, 2) @default(0)
  discountId     String?
  discount       Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountName   String?   // snapshot: el nombre sobrevive al borrado del descuento
  /// Decisión manual del operario sobre el descuento de ESTA cuota:
  /// null = automático (manda la regla), true = aplicarlo igual, false = no aplicarlo.
  discountOverride Boolean?

  /// Lo que se debe mientras está impaga; al cobrarla pasa a ser lo que se cobró:
  ///   amount = baseAmount + lateFee + methodAdjustment + manualAdjustment
  amount        Decimal        @db.Decimal(10, 2)
  status        PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  // Monto de la cuota antes del ajuste del medio de pago, y el ajuste aplicado
  // (positivo = recargo, negativo = descuento). Solo se completan al cobrar.
  baseAmount       Decimal?    @db.Decimal(10, 2)
  methodAdjustment Decimal?    @db.Decimal(10, 2)
  // Recargo por mora congelado al cobrar, y los días de atraso con los que se
  // calculó. `lateFeeWaived` lo condona a mano para esta cuota puntual.
  lateFee          Decimal?    @db.Decimal(10, 2)
  lateDays         Int?
  lateFeeWaived    Boolean     @default(false)
  // Diferencia que puso a mano quien cobró: un redondeo, unos pesos de menos,
  // una diferencia acordada. Firmada (+ cobró de más / − cobró de menos), con
  // el motivo opcional que se dejó anotado.
  manualAdjustment       Decimal? @db.Decimal(10, 2)
  manualAdjustmentReason String?
  paidAt        DateTime?
  verified      Boolean        @default(false)
  cashClosingId String?
  cashClosing   CashClosing?   @relation(fields: [cashClosingId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime       @default(now())

  @@unique([studentId, period])
  @@index([gymId, period, status])
  @@index([cashClosingId])
  @@index([discountId])
}

/// Descuento configurable por gimnasio. Se asigna a alumnos vía StudentDiscount
/// y se aplica sobre la cuota al generarla.
model Discount {
  id          String       @id @default(cuid())
  gymId       String
  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        DiscountType
  value       Decimal      @db.Decimal(10, 2)
  active      Boolean      @default(true)
  /// Si es true, el descuento se pierde cuando la cuota pasa el plazo para pagarlo.
  loseOnLatePayment Boolean @default(false)
  /// Días de tolerancia después del vencimiento de la cuota antes de perder el
  /// descuento. 0 = se pierde el mismo día que vence. Solo aplica con `loseOnLatePayment`.
  graceDays         Int     @default(0)
  createdAt   DateTime     @default(now())

  students StudentDiscount[]
  payments Payment[]

  @@unique([gymId, name])
  @@index([gymId])
}

/// Asignación de un descuento a un alumno, con vigencia por período mensual.
/// `validFrom` / `validUntil` son el primer día del mes (igual que Payment.period);
/// `validUntil` null = sin fecha de corte. El servicio garantiza que las vigencias
/// de un mismo alumno no se solapen, así siempre hay a lo sumo uno aplicable.
model StudentDiscount {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discountId String
  discount   Discount  @relation(fields: [discountId], references: [id], onDelete: Cascade)
  validFrom  DateTime
  validUntil DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([studentId])
  @@index([discountId])
}

/// Configuración por gimnasio de cada medio de pago: si está habilitado y qué
/// recargo o descuento (en %) se aplica sobre la cuota al cobrar con él.
/// La ausencia de fila equivale al default: habilitado y sin ajuste.
model PaymentMethodConfig {
  id                String                @id @default(cuid())
  gymId             String
  gym               Gym                   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  enabled           Boolean               @default(true)
  adjustmentType    PaymentAdjustmentType @default(NONE)
  adjustmentPercent Decimal               @default(0) @db.Decimal(5, 2)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([gymId, method])
  @@index([gymId])
}

/// Regla de mora del gimnasio: pasados `graceDays` del vencimiento, la cuota
/// impaga suma un recargo de `feeValue` ($ o %), que se repite cada
/// `repeatEveryDays` mientras siga impaga (null = una sola vez).
/// Dos topes opcionales e independientes: `maxCharges` limita cuántas veces
/// puede cobrarse y `maxFeeAmount` cuánto puede acumular en pesos.
/// La ausencia de fila equivale al default: regla apagada.
model LateFeeConfig {
  id              String      @id @default(cuid())
  gymId           String      @unique
  gym             Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  enabled         Boolean     @default(false)
  graceDays       Int         @default(0)
  feeType         LateFeeType @default(PERCENT)
  feeValue        Decimal     @default(0) @db.Decimal(10, 2)
  repeatEveryDays Int?
  maxCharges      Int?
  maxFeeAmount    Decimal?    @db.Decimal(10, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model StudentFile {
  id          String          @id @default(cuid())
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gymId       String
  gym         Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  fileType    StudentFileType
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime        @default(now())

  @@index([studentId])
  @@index([gymId])
}

model CashClosing {
  id                 String   @id @default(cuid())
  gymId              String
  gym                Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  fromDate           DateTime // paidAt of earliest payment
  toDate             DateTime // paidAt of latest payment
  closedAt           DateTime @default(now())
  totalCollected     Decimal  @db.Decimal(10, 2)
  paidCount          Int
  cashCount          Int      @default(0)
  cashTotal          Decimal  @db.Decimal(10, 2) @default(0)
  transferCount      Int      @default(0)
  transferTotal      Decimal  @db.Decimal(10, 2) @default(0)
  cardCount          Int      @default(0)
  cardTotal          Decimal  @db.Decimal(10, 2) @default(0)
  // Cuánto de lo cobrado salió de ajustes puestos a mano al cobrar, para que el
  // cierre muestre la diferencia contra lo que decían las cuotas.
  adjustmentsCount   Int      @default(0)
  adjustmentsTotal   Decimal  @db.Decimal(10, 2) @default(0)
  notes              String?
  createdAt          DateTime @default(now())

  payments Payment[]

  @@index([gymId])
}

model Attendance {
  id            String   @id @default(cuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date          DateTime
  detail        Json?
  takenByUserId String?
  takenByName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, date])
  @@index([gymId, date])
}
